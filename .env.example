# Copy to .env for local runs. Never commit real secrets.

# Dataset paths
DATASET=geobrowse_level2
DATA_DIR=./data
OUTPUT_DIR=./outputs

# Browser service
TAIJI=False
PLAYWRIGHT_BACKEND=local
BROWSERLESS_TARGET_HOST=production-sfo.browserless.io
BROWSERLESS_TOKEN=
LISTEN_PORT=3000
WEB_IP=localhost:3000

# Model backend
LLM_URL=gpt:gpt-4.1
VLM_URL=gpt:gpt-4.1
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Optional cloud storage for image upload/download workflows
SECRET_ID=
SECRET_KEY=
REGION=ap-guangzhou
BUCKET=

# Search
SEARCH_BACKEND=DuckDuckGo
SEARCH_API_KEY=
SEARCH_CSE_ID=

# Evaluation
API_KEY=
BASE_URL=https://api-inference.modelscope.cn/v1/
JUDGE_MODEL=Qwen/Qwen2.5-32B-Instruct
MAX_WORKERS=8
